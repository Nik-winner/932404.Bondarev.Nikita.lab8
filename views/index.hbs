<div class="page-layout">
    <aside class="sidebar">
        <h2>Фильтры</h2>
        <form id="filterForm" method="GET" action="/">
            <div class="form-group">
                <label for="search">Поиск по заголовку</label>
                <input type="text" id="search" name="search" value="{{filters.search}}" placeholder="Например: iPhone">
            </div>

            <div class="form-group">
                <label for="category">Категория</label>
                <select id="category" name="category">
                    <option value="">Все категории</option>
                    {{#each categories}}
                        <option value="{{this}}" {{#if (eq ../filters.category this)}}selected{{/if}}>
                            {{categoryName this}}
                        </option>
                    {{/each}}
                </select>
            </div>

            <div class="form-group">
                <label for="status">Статус</label>
                <select id="status" name="status">
                    <option value="">Любой</option>
                    {{#each statuses}}
                        <option value="{{this}}" {{#if (eq ../filters.status this)}}selected{{/if}}>
                            {{statusName this}}
                        </option>
                    {{/each}}
                </select>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="minPrice">Цена от</label>
                    <input type="number" id="minPrice" name="minPrice" min="0" step="0.01" value="{{filters.minPrice}}">
                </div>
                <div class="form-group">
                    <label for="maxPrice">Цена до</label>
                    <input type="number" id="maxPrice" name="maxPrice" min="0" step="0.01" value="{{filters.maxPrice}}">
                </div>
            </div>

            <button type="submit" class="btn-primary btn-block">Применить</button>
            <a href="/" class="btn-secondary btn-block">Сбросить</a>
        </form>
    </aside>

    <section class="content">
        <div class="content-header">
            <h2>Объявления <span class="count">({{adsCount}})</span></h2>
        </div>

        {{#if ads.length}}
            <div class="ads-grid">
                {{#each ads}}
                    {{> ad-card}}
                {{/each}}
            </div>
        {{else}}
            <div class="empty-state">
                <p>Объявления не найдены</p>
                <a href="/create" class="btn-primary">Подать первое объявление</a>
            </div>
        {{/if}}
    </section>
</div>